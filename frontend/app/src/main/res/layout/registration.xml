<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="RegistrationViewModel"
            type="com.example.venclima.viewModels.RegistrationViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/registration_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintWidth_percent="0.80"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrazione nuovo utente"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/email_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:textSize="18sp"
            android:background="@drawable/rounded_corner"
            android:padding="16dp"
            android:inputType="textEmailAddress"
            android:text="@={RegistrationViewModel.email}"/>

        <EditText
            android:id="@+id/firstname_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome"
            android:textSize="18sp"
            android:background="@drawable/rounded_corner"
            android:padding="16dp"
            android:inputType="text"
            android:layout_marginTop="16dp"
            android:text="@={RegistrationViewModel.name}"/>

        <EditText
            android:id="@+id/lastname_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cognome"
            android:textSize="18sp"
            android:background="@drawable/rounded_corner"
            android:padding="16dp"
            android:inputType="text"
            android:layout_marginTop="16dp"
            android:text="@={RegistrationViewModel.surname}"/>

        <EditText
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:textSize="18sp"
            android:background="@drawable/rounded_corner"
            android:padding="16dp"
            android:inputType="textPassword"
            android:layout_marginTop="16dp"
            android:text="@={RegistrationViewModel.password}"/>

        <EditText
            android:id="@+id/conf_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Conferma password"
            android:textSize="18sp"
            android:background="@drawable/rounded_corner"
            android:padding="16dp"
            android:inputType="textPassword"
            android:layout_marginTop="16dp"
            android:text="@={RegistrationViewModel.confirmPassword}"/>

        <Button
            android:id="@+id/registration_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrati"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:padding="16dp"
            android:layout_marginTop="32dp"
            android:textSize="18sp"
            android:onClick="@{() -> RegistrationViewModel.onRegistrationButtonClicked()}"/>

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
