<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/b_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Section A: Prima dell'acqua alta -->
                <LinearLayout
                    android:id="@+id/header_before"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/b_opt1"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <ImageView
                        android:id="@+id/chev_before"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0"
                        android:contentDescription="@null"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/content_before"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b_opt1_text"
                    android:textSize="14sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Section B: Durante l'acqua alta -->
                <LinearLayout
                    android:id="@+id/header_during"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/b_opt2"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/chev_during"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0"
                        android:contentDescription="@null"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/content_during"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b_opt2_text"
                    android:textSize="14sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Section C: Dopo l'acqua alta -->
                <LinearLayout
                    android:id="@+id/header_after"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/b_opt3"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/chev_after"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0"
                        android:contentDescription="@null"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/content_after"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/b_opt3_text"
                    android:textSize="14sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        
        <!-- Contatti utili  -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border">

            <LinearLayout
