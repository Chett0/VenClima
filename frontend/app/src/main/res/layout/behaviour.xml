                    android:layout_height="wrap_content"
                    android:text="@string/eme_number"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/card_border" android:layout_marginBottom="8dp" />

                <LinearLayout
