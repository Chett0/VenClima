<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Come comportarsi"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Section A: Prima dell'acqua alta -->
                <LinearLayout
                    android:id="@+id/header_before"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="1) Prima dell’acqua alta"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/chev_before"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0" />

                </LinearLayout>

                <TextView
                    android:id="@+id/content_before"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Suggerimenti per la preparazione preventiva:\n\n• Sollevare mobili, dispositivi elettrici e oggetti di valore.\n• Installare paratie o sistemi di protezione.\n• Verificare il corretto funzionamento delle pompe di sollevamento domestiche.\n• Preparare un kit di emergenza (stivali, torce, batterie, documenti).\n• Monitorare notifiche e previsioni via app.\n• Evitare di lasciare veicoli in zone a rischio."
                    android:textSize="14sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Section B: Durante l'acqua alta -->
                <LinearLayout
                    android:id="@+id/header_during"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="2) Durante l’acqua alta"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/chev_during"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0" />

                </LinearLayout>

                <TextView
                    android:id="@+id/content_during"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comportamenti per ridurre i rischi:\n\n• Evitare di camminare in acque profonde o in zone non illuminate.\n• Fare attenzione ai cavi elettrici, tombini aperti o ostacoli non visibili.\n• Usare solo passerelle autorizzate.\n• Non forzare porte o accessi con forte pressione dell’acqua.\n• Limitare l’uso di veicoli e mezzi privati.\n• Indossare stivali alti o protezioni impermeabili."
                    android:textSize="14sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Section C: Dopo l'acqua alta -->
                <LinearLayout
                    android:id="@+id/header_after"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="3) Dopo l’acqua alta"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/chev_after"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0" />

                </LinearLayout>

                <TextView
                    android:id="@+id/content_after"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Linee guida per il rientro alla normalità:\n\n• Evitare l’accensione di apparecchi elettrici finché non sono asciutti e verificati.\n• Pulire e disinfettare locali e superfici contaminate da acqua salmastra.\n• Smaltire correttamente eventuali beni danneggiati.\n• Segnalare danni strutturali agli uffici competenti.\n• Annotare eventuali danni per richieste assicurative."
                    android:textSize="14sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        
