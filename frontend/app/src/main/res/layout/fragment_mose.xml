<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title_mose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mose_title_full"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/sub_mose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mose_sub"
            android:textSize="13sp"
            android:textColor="@color/bottom_nav_unselected"
            android:layout_marginBottom="12dp" />

        <!-- Stato Attuale - NON ATTIVO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mose_inactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_calm_sea"
                    app:tint="@color/azzurro"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:contentDescription="@string/mose_desc_inactive" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mose_state_label"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mose_standby"
                        android:textSize="14sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/status_inactive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_status_pill_inactive"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="@string/mose_non_active"
                    android:textColor="@color/status_inactive_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="72dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Stato Attuale - ATTIVO-->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mose_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/status_active_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/status_active_text"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="12dp"
                    android:contentDescription="@string/mose_desc_active" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mose_state_label"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mose_ready"
                        android:textSize="14sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/status_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mose_active"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_status_pill_active"
                    android:textColor="@color/status_active_text"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="72dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Informazioni dettagliate su MOSE (sezioni espandibili) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mose_whatis_title"
                    android:textColor="@color/black"
                    android:textStyle="bold"

                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/overview_mose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mose_overview"
                    android:textSize="13sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:layout_marginBottom="12dp" />

                <!-- Section: Come funziona -->
                <LinearLayout
                    android:id="@+id/header_how"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/mose_how_title"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/chev_how"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0" />

                </LinearLayout>

                <TextView
                    android:id="@+id/content_how"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mose_how_content"
                    android:textSize="13sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Section: Quando viene attivato -->
                <LinearLayout
                    android:id="@+id/header_when"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/mose_when_title"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/chev_when"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0" />

                </LinearLayout>

                <TextView
                    android:id="@+id/content_when"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mose_when_content"
                    android:textSize="13sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Section: Dati tecnici -->
                <LinearLayout
                    android:id="@+id/header_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/mose_data_title"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/chev_data"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more"
                        android:rotation="0" />

                </LinearLayout>

                <TextView
                    android:id="@+id/content_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mose_data_content"
                    android:textSize="13sp"
                    android:textColor="@color/bottom_nav_unselected"
                    android:lineSpacingExtra="2dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
